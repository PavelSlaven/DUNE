    "primary_buildings": {
      "page": "https://www.spriters-resource.com/pc_computer/dune2000/",
      "rule": "Use the original healthy Dune 2000 sprite for every matching D2TM building and retain the separate Atreides, Harkonnen and Ordos designs.",
      "available": [
        "Barracks",
        "Construction Yard",
        "Heavy Factory",
        "High Tech Factory",
        "Light Factory",
        "Outpost",
        "Palace",
        "Spice Refinery",
        "Spice Silo",
        "Starport",
        "Wind Trap"
      ]
    },
    "fallback_units": "Use Dune II or Battle for Arrakis only when Dune 2000 has no matching pose, animation or object.",
